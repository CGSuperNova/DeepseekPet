# 领域知识问答系统 · 配置模板
# 用法：把本文件复制为 .env 并按需修改。所有项都有默认值，除 API Key 外都可省略。

# ============ 云端大模型（OpenAI 兼容协议）============
# DeepSeek：https://platform.deepseek.com 申请
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=120
MAX_HISTORY_TURNS=3

# 换成任意 OpenAI 协议服务只需改上面三行，例如：
#   DEEPSEEK_BASE_URL=http://127.0.0.1:8000/v1
#   DEEPSEEK_MODEL=Qwen2.5-7B-Instruct
#   DEEPSEEK_API_KEY=EMPTY

# 提示词：约束「只依据资料回答、必须标引用」是可信度的关键，一般不用改
# SYSTEM_PROMPT=你是一个领域专家助手。只能依据提供的资料回答问题，必须用 [编号] 标注引用来源。如果资料中没有答案，就明确说不知道，不要编造。
# NO_CONTEXT_REPLY=知识库中没有找到与问题相关的资料，请换一种问法，或先上传相关文档并重建索引。

# ============ 目录（相对本文件夹）============
DATA_DIR=data
DB_DIR=db_index
LOG_DIR=logs
COLLECTION_NAME=knowledge

# ============ 模型 ============
EMBED_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_ENABLED=true
RERANK_BATCH_SIZE=8
USE_FP16=false

# 国内下载模型用镜像；模型已下载好后建议保持离线
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_OFFLINE=true

# 换了 EMBED_MODEL 要先设 HF_HUB_OFFLINE=false 跑一次把模型下下来，再改回 true

# ============ CPU 性能（关键）============
# 0/auto = 自动探测（约物理核数一半，上限 8）。
# 实测：20 逻辑核机器上 torch 默认 14 线程会严重超订，压到 8 线程后快约 4 倍。
TORCH_THREADS=auto
TORCH_INTEROP_THREADS=1

# ============ 分块与检索 ============
CHUNK_SIZE=600
CHUNK_OVERLAP=80
TOP_K_RETRIEVE=20
# 重排很贵（CPU 上约 6~8 秒/对）。想更快就调小，想更准则调大（有 GPU 可到 20~30）
TOP_K_RERANK=5
TOP_K_FINAL=5
RRF_K=60

# ---- 重排性能优化（默认已开，实测把单轮检索从 ~56s 压到 ~22s）----
# 只把候选片段的前 N 个 token 交给重排模型。实测 6 个候选：
#   512→55s ｜ 384→41s ｜ 256→26s ｜ 192→19s
# 文档里「答案常在片段末尾」时可调回 384/512（更慢更准）
RERANK_MAX_LENGTH=256
# 重排结果缓存条数（按 问题+片段 记分）；0 = 关闭
RERANK_CACHE_SIZE=512
# 向量检索第一名领先第二名超过该余弦分差时跳过重排；0 = 总是重排
RERANK_SKIP_MARGIN=0.08
# 启动后在后台预热模型（首次加载 30~40 秒，预热后第一个请求不必等）
WARMUP_ON_START=true

# 阈值是可选的「及格线」：0 表示不过滤。不要随手填默认值，否则会误杀好片段。
SIMILARITY_THRESHOLD=0
RERANK_THRESHOLD=0

# 建库时跳过的文件（通配符，逗号分隔），用于排除草稿/旧版本
# 例：INGEST_EXCLUDE=*v1.0*,*.draft.md,*_备份*
INGEST_EXCLUDE=

# ============ HTTP 服务 ============
HOST=127.0.0.1
PORT=8100
THREADS=4

# 允许调用接口的 Key（逗号分隔）。**留空 = 不鉴权**，对外服务前务必设置。
# 例：API_KEYS=ak_screen_9f2e,ak_miniapp_77c1
API_KEYS=

# 允许跨域来源（逗号分隔）；留空则不发送 CORS 头
# CORS_ORIGINS=http://localhost:3000,https://your-site.com
